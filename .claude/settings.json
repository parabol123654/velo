{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)"
    ],
    "deny": [
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(go vet *-vettool*)"
    ]
  }
}
